#!/bin/bash -e
# Configure Jellyfin after the appliance administrator password is available.

. /etc/default/inithooks

JELLYFIN_BASE=http://127.0.0.1:8096

chown -R jellyfin:users /var/lib/jellyfin
systemctl enable --now jellyfin

ready=false
for attempt in $(seq 1 60); do
    if curl -fsS "$JELLYFIN_BASE/health" >/dev/null; then
        ready=true
        break
    fi
    sleep 5
done
[ "$ready" = true ]

[ -e "$INITHOOKS_CONF" ] && . "$INITHOOKS_CONF"
"$INITHOOKS_PATH/bin/jellyfin-server.py" --pass="$APP_PASS"

systemctl stop jellyfin
JELLYFIN_CONFIG=/etc/jellyfin/system.xml
sed -i '/<IsBehindProxy*/d' "$JELLYFIN_CONFIG"
sed -i "/<\/ServerConfiguration/i \ <IsBehindProxy>true</IsBehindProxy>" \
    "$JELLYFIN_CONFIG"

systemctl start jellyfin
